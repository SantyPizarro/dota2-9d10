# ==========================================
# DOTA2-9D10 CONFIGURACIÓN
# ==========================================

# Token del bot de Discord obtenido en https://discord.com/developers/applications
DISCORD_BOT_TOKEN=tu_token_de_discord_aqui

# ID del canal de Discord donde el bot enviará y actualizará el mensaje de estado
DISCORD_CHANNEL_ID=123456789012345678

# (Opcional) Tu ID de usuario en Discord para mencionarte en la alerta
DISCORD_USER_ID=

# Lista blanca de IDs de usuarios autorizados a presionar los botones (separados por coma)
# Si lo dejas vacío, solo el DISCORD_USER_ID podrá interactuar.
# Ejemplo: ALLOWED_USER_IDS=123456789012345678,987654321098765432
ALLOWED_USER_IDS=

# Intervalo en segundos entre cada chequeo de pantalla (2.0s recomendado para consumo 0% CPU)
CHECK_INTERVAL=2.0

# Pausar automáticamente el monitor tras iniciar la partida (en minutos, ej. 25 min)
AUTO_PAUSE_MINUTES=25

# Título de la ventana de Dota 2 (por defecto "Dota 2")
DOTA2_WINDOW_TITLE=Dota 2
